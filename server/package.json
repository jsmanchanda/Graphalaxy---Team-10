{
  "name": "@graphalaxy/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('var/game.db',{force:true})\" && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "@graphalaxy/shared": "*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
