{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "build",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "client/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "test/**/*.ts"
  ]
}
