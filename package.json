{
  "name": "graphalaxy---team-10",
  "version": "1.0.0",
  "description": "CSE-110 Team 10 Group Project",
  "scripts": {
    "lint": "gts lint",
    "test": "npm run lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "pretest": "npm run compile",
    "posttest": "npm run lint",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.7.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^65.4.2",
    "gts": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "tmp": "^0.2.6"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "eslint --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "ci",
          "docs",
          "feat",
          "fix",
          "perf",
          "refactor",
          "revert",
          "style",
          "test"
        ]
      ]
    }
  }
}
